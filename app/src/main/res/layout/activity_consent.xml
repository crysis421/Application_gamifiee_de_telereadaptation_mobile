<?xml version="1.0" encoding="utf-8"?>
<!--
    Notice d'information et consentement (US-9.1).
    Présentée au premier lancement, puis consultable depuis les réglages. Gros caractères et
    boutons larges : le participant peut être une personne âgée ou en rééducation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/consent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/consent_title"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnSurface" />

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:background="?attr/colorPrimary" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentBody"
                android:layout_marginTop="16dp"
                android:text="@string/consent_intro" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentHeading"
                android:text="@string/consent_camera_title" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentBody"
                android:text="@string/consent_camera_body" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentHeading"
                android:text="@string/consent_data_title" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentBody"
                android:text="@string/consent_data_body" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentHeading"
                android:text="@string/consent_steps_title" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentBody"
                android:text="@string/consent_steps_body" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentHeading"
                android:text="@string/consent_rights_title" />

            <TextView
                style="@style/TextAppearance.SAES5.ConsentBody"
                android:text="@string/consent_rights_body" />

            <TextView
                android:id="@+id/consent_accepted_on"
                style="@style/TextAppearance.SAES5.ConsentBody"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/consent_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="56dp"
                android:text="@string/consent_checkbox"
                android:textSize="@dimen/text_body_large" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/consent_accept"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_large"
            android:enabled="false"
            android:text="@string/consent_accept"
            android:textSize="@dimen/button_text_large" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/consent_secondary"
            style="@style/Widget.SAES5.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/consent_refuse"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
