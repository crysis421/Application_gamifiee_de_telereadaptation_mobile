<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/catalog_title"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/colorOnSurface" />

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="?attr/colorPrimary" />

    <!-- Filtre : groupe musculaire -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_spacing"
        android:text="@string/muscle_label"
        android:textAppearance="@style/TextAppearance.SAES5.Label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/muscle_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_muscle_all"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all_muscles" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_muscle_legs"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_legs" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_muscle_chest"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_chest" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_muscle_arms"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_arms" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_muscle_core"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_core" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_muscle_back"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muscle_back" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Filtre : difficulté -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/difficulty_label"
        android:textAppearance="@style/TextAppearance.SAES5.Label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/difficulty_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_difficulty_all"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all_difficulties" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_difficulty_easy"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty_easy" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_difficulty_medium"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty_medium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_difficulty_hard"
                style="@style/Widget.SAES5.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/difficulty_hard" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Durée + matériel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.SAES5.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/duration_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/duration_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.SAES5.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/equipment_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/equipment_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/apply_filters" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_button"
            style="@style/Widget.SAES5.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/reset_filters" />
    </LinearLayout>

    <!-- Liste + bouton flottant "Créer un exercice" -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/block_spacing"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/exercises_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/create_exercise_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/block_spacing"
            android:text="@string/create_exercise"
            app:icon="@drawable/ic_add" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
