<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/exercise_camera_preview_description"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <com.uphf.saes5.OverlayView
        android:id="@+id/poseOverlay"
        android:alpha="0.70"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/feedbackTint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.20"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/session_panel"
            android:padding="10dp">

            <ImageView
                android:id="@+id/referenceImage"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/session_reference"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exerciseName"
                    style="@style/SessionText"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/comparisonStatus"
                    style="@style/SessionText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/similarityScore"
                    style="@style/SessionText"
                    android:text="@string/exercise_similarity_unavailable" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chronometer"
                    style="@style/SessionText" />

                <TextView
                    android:id="@+id/repCounter"
                    style="@style/SessionText"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/feedbackBanner"
            style="@style/SessionText"
            android:layout_gravity="center"
            android:background="@drawable/session_panel"
            android:gravity="center"
            android:padding="12dp"
            android:textSize="20sp"
            android:accessibilityLiveRegion="polite"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/countdown"
            style="@style/SessionText"
            android:layout_gravity="center"
            android:background="@drawable/session_panel"
            android:gravity="center"
            android:padding="16dp"
            android:textSize="32sp"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/validateRepButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/exercise_validate_rep"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/failRepButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/exercise_fail_rep"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/finishButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_finish" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
