<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran d'exécution de l'exercice.
    Tous les éléments clés (compteur, chrono, feedback, boutons) sont surdimensionnés :
    l'utilisateur doit pouvoir les lire et les atteindre à plusieurs mètres de l'écran (US-3.1).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exerciseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Élévations latérales" />

        <TextView
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFeatureSettings="tnum"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_session_chrono"
            android:textStyle="bold"
            tools:text="01:24" />
    </LinearLayout>

    <!-- Filet primaire sous le titre, comme sur les autres écrans de l'application. -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="?attr/colorPrimary" />

    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/block_spacing"
        android:layout_weight="1"
        android:background="@drawable/bg_camera_placeholder">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/exercise_camera_preview_description"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <com.uphf.saes5.OverlayView
            android:id="@+id/poseOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_feedback_banner"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/similarityScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_similarity_unavailable"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/text_session_score"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/comparisonStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="@dimen/session_status_max_width"
                android:text="@string/exercise_similarity_waiting"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="@dimen/text_session_status"
                android:textStyle="bold" />

            <!-- Latence moyenne de l'analyse (US-1.4) : indication technique, volontairement discrète. -->
            <TextView
                android:id="@+id/latencyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Latence 48 ms"
                tools:visibility="visible" />
        </LinearLayout>

        <!--
            Bandeau de feedback (US-3.2). La couleur est posée par le code via un tint : le
            fond reste donc arrondi comme les cartes du reste de l'application.
        -->
        <TextView
            android:id="@+id/feedbackBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_feedback_banner"
            android:backgroundTint="@color/app_success"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/colorOnPrimary"
            android:textSize="@dimen/text_session_feedback"
            android:textStyle="bold"
            android:visibility="invisible"
            tools:text="Répétition validée"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/repCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/block_spacing"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_counter_huge"
        android:textStyle="bold"
        tools:text="7 / 12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/exercise_reps_label"
        android:textAppearance="@style/TextAppearance.SAES5.Label"
        android:textSize="16sp" />

    <!-- Score arcade et multiplicateur (US-4.4), masqué si l'élément de jeu est désactivé. -->
    <TextView
        android:id="@+id/arcadeScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_session_score"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="1 240 pts · ×3"
        tools:visibility="visible" />

    <!-- Secours pour les anciens exercices sans modèle ou si la caméra est refusée. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/validateRepButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginTop="@dimen/block_spacing"
        android:text="@string/exercise_validate_rep"
        android:textSize="@dimen/button_text_large"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/failRepButton"
        style="@style/Widget.SAES5.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/exercise_fail_rep"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Grand bouton contrasté : on doit pouvoir l'atteindre sans viser en revenant vers l'écran. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishButton"
        style="@style/Widget.SAES5.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_large"
        android:layout_marginTop="8dp"
        android:text="@string/exercise_finish"
        android:textSize="@dimen/button_text_large" />
</LinearLayout>
